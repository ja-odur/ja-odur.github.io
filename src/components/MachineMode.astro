---
import { machineContext } from '~/data/machine';

// "copy context" hands over the same document /llms.txt serves
const doc = machineContext();
---

<div
  class="machine-split mono"
  id="machine-split"
  role="separator"
  aria-orientation="vertical"
  aria-label="Machine view: drag left, or press Enter, to see this page as a language model receives it"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="100"
  tabindex="0"
  hidden
>
  <span class="split-label split-human" aria-hidden="true">humans</span>
  <span class="split-label split-machine" aria-hidden="true">machines</span>
  <span class="split-label split-hint" aria-hidden="true">machine view</span>
  <span class="split-grip" aria-hidden="true"></span>
</div>

<div class="machine-bar mono" id="machine-bar" role="region" aria-label="Machine mode" hidden>
  <span class="bar-status">
    <span class="bar-dot" aria-hidden="true"></span>
    <strong id="machine-count">0</strong> of <span id="machine-total">0</span> tokens converted
    <span class="bar-hint">· hover an id to see its word</span>
  </span>
  <span class="bar-actions">
    <a href="/llms.txt">/llms.txt</a>
    <button type="button" id="machine-copy">copy context</button>
    <button type="button" id="machine-exit">exit <kbd>esc</kbd></button>
  </span>
  <template id="machine-source">{doc}</template>
</div>

<style>
  /* the divider: a fixed track moved by --mk-split; the hit area is 20px
     wide around the 1px line. Three looks:
     - at rest with room (.at-rest.roomy): in the right margin, line and
       "humans | machines" labels showing — nothing touches content;
     - at rest without room (.at-rest:not(.roomy), phones): a compact grip
       inside the page gutter, the only part that takes the pointer;
     - over content: a bare line whose labels appear on hover, focus, drag. */
  .machine-split {
    position: fixed;
    top: var(--nav-height);
    bottom: 0;
    left: 0;
    z-index: 44;
    width: 20px;
    margin-left: -10px;
    transform: translateX(var(--mk-split, 0px));
    cursor: col-resize;
    touch-action: none;
  }

  .machine-split[hidden] {
    display: none;
  }

  .machine-split::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--accent);
    opacity: 0.7;
  }

  .machine-split:focus-visible {
    outline: none;
  }

  .machine-split.at-rest:not(.roomy) {
    margin-left: -20px;
    pointer-events: none;
  }

  .machine-split.at-rest:not(.roomy)::before {
    display: none;
  }

  /* hidden, not removed: computeRest() measures the labels */
  .machine-split.at-rest:not(.roomy) .split-human,
  .machine-split.at-rest:not(.roomy) .split-machine {
    visibility: hidden;
  }

  /* centered 10px in from the edge, it stays inside the 20px page gutter */
  .machine-split.at-rest:not(.roomy) .split-grip {
    pointer-events: auto;
    width: 12px;
    height: 52px;
    cursor: pointer;
  }

  .split-hint {
    display: none;
  }

  .machine-split.at-rest:not(.roomy) .split-hint {
    display: block;
    top: 50%;
    right: calc(50% + 0.75rem);
    transform: translateY(-50%);
    color: var(--text-faint);
    opacity: 0;
    transition: opacity var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  .machine-split.at-rest:not(.roomy):hover .split-hint,
  .machine-split.at-rest:not(.roomy):focus-visible .split-hint {
    opacity: 1;
    color: var(--accent);
  }

  .split-hint::before {
    content: '← ';
  }

  .machine-split:focus-visible .split-grip,
  .machine-split:hover .split-grip {
    border-color: var(--accent);
  }

  .split-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 44px;
    transform: translate(-50%, -50%);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    background:
      linear-gradient(var(--accent), var(--accent)) center / 1px 16px no-repeat,
      var(--bg-raised);
    transition: border-color var(--speed) var(--ease);
  }

  .split-label {
    position: absolute;
    top: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--bg-overlay);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* over content the line stays bare (labels would sit on the page); they
     appear while you hover, focus or drag it, and always at a roomy rest */
  .split-human,
  .split-machine {
    opacity: 0;
    transition: opacity var(--speed) var(--ease);
  }

  .machine-split.at-rest.roomy .split-human,
  .machine-split.at-rest.roomy .split-machine,
  .machine-split:hover .split-human,
  .machine-split:hover .split-machine,
  .machine-split:focus-visible .split-human,
  .machine-split:focus-visible .split-machine,
  :global(body.mk-dragging) .split-human,
  :global(body.mk-dragging) .split-machine {
    opacity: 1;
  }

  .split-human {
    right: calc(50% + 0.5rem);
    color: var(--text-secondary);
  }

  .split-machine {
    left: calc(50% + 0.5rem);
    color: var(--accent);
  }


  .machine-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding: 0.6rem 1.25rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    background: var(--bg-overlay);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    /* shown only while the divider moves, then lingers a few seconds (see
       showBar() in machine-mode.ts) */
    transform: translateY(100%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }

  .machine-bar.shown {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-bar,
    .machine-bar.shown {
      transform: none;
      transition: none;
    }
  }

  .machine-bar[hidden] {
    display: none;
  }

  .bar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bar-status strong {
    color: var(--accent);
    font-weight: 600;
  }

  .bar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar-dot {
      animation: bar-pulse 1.6s var(--ease) infinite;
    }

    @keyframes bar-pulse {
      50% {
        opacity: 0.35;
      }
    }
  }

  @media (max-width: 560px) {
    .bar-hint {
      display: none;
    }
  }

  .bar-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar-actions a {
    color: var(--text-secondary);
    margin-right: 0.25rem;
  }

  .machine-bar button {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    transition: color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  .machine-bar button:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
</style>
