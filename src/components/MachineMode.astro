---
import { machineContext } from '~/data/machine';

// "copy context" hands over the same document /llms.txt serves
const doc = machineContext();
---

<div class="machine-bar mono" id="machine-bar" role="region" aria-label="Machine mode" hidden>
  <span class="bar-status">
    <span class="bar-dot" aria-hidden="true"></span>
    this page is <strong id="machine-count">0</strong> tokens
    <span class="bar-hint">· hover an id to see its word</span>
  </span>
  <span class="bar-actions">
    <a href="/llms.txt">/llms.txt</a>
    <button type="button" id="machine-copy">copy context</button>
    <button type="button" id="machine-exit">exit <kbd>esc</kbd></button>
  </span>
  <template id="machine-source">{doc}</template>
</div>

<style>
  .machine-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding: 0.6rem 1.25rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    background: var(--bg-overlay);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .machine-bar[hidden] {
    display: none;
  }

  .bar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bar-status strong {
    color: var(--accent);
    font-weight: 600;
  }

  .bar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar-dot {
      animation: bar-pulse 1.6s var(--ease) infinite;
    }

    @keyframes bar-pulse {
      50% {
        opacity: 0.35;
      }
    }
  }

  @media (max-width: 560px) {
    .bar-hint {
      display: none;
    }
  }

  .bar-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar-actions a {
    color: var(--text-secondary);
    margin-right: 0.25rem;
  }

  .machine-bar button {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    transition: color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  .machine-bar button:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
</style>
