---
import { machineContext } from '~/data/machine';

// "copy context" hands over the same document /llms.txt serves
const doc = machineContext();
---

<div
  class="machine-split mono"
  id="machine-split"
  role="separator"
  aria-orientation="vertical"
  aria-label="Machine view: drag left, or press Enter, to see this page as a language model receives it"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="100"
  tabindex="0"
  hidden
>
  <span class="split-label split-human" aria-hidden="true">human</span>
  <span class="split-label split-machine" aria-hidden="true">tokens</span>
  <span class="split-label split-hint" aria-hidden="true">machine view</span>
  <span class="split-grip" aria-hidden="true"></span>
</div>

<div class="machine-bar mono" id="machine-bar" role="region" aria-label="Machine mode" hidden>
  <span class="bar-status">
    <span class="bar-dot" aria-hidden="true"></span>
    this page is <strong id="machine-count">0</strong> tokens
    <span class="bar-hint">· hover an id to see its word</span>
  </span>
  <span class="bar-actions">
    <a href="/llms.txt">/llms.txt</a>
    <button type="button" id="machine-copy">copy context</button>
    <button type="button" id="machine-exit">exit <kbd>esc</kbd></button>
  </span>
  <template id="machine-source">{doc}</template>
</div>

<style>
  /* the divider: a fixed track moved by --mk-split; the hit area is 20px
     wide around the 1px line. Docked at the right edge it shows only its
     grip (and only the grip takes the pointer, so the strip never blocks
     content near the edge). */
  .machine-split {
    position: fixed;
    top: var(--nav-height);
    bottom: 0;
    left: 0;
    z-index: 44;
    width: 20px;
    margin-left: -10px;
    transform: translateX(var(--mk-split, 0px));
    cursor: col-resize;
    touch-action: none;
  }

  .machine-split[hidden] {
    display: none;
  }

  .machine-split::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--accent);
    opacity: 0.7;
  }

  .machine-split:focus-visible {
    outline: none;
  }

  .machine-split.docked {
    margin-left: -26px;
    pointer-events: none;
  }

  .machine-split.docked::before,
  .machine-split.docked .split-human,
  .machine-split.docked .split-machine {
    display: none;
  }

  .machine-split.docked .split-grip {
    pointer-events: auto;
    width: 16px;
    height: 56px;
    cursor: pointer;
  }

  .split-hint {
    display: none;
  }

  .machine-split.docked .split-hint {
    display: block;
    top: 50%;
    right: calc(50% + 0.85rem);
    transform: translateY(-50%);
    color: var(--text-faint);
    opacity: 0;
    transition: opacity var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  .machine-split.docked:hover .split-hint,
  .machine-split.docked:focus-visible .split-hint {
    opacity: 1;
    color: var(--accent);
  }

  .split-hint::before {
    content: '← ';
  }

  .machine-split:focus-visible .split-grip,
  .machine-split:hover .split-grip {
    border-color: var(--accent);
  }

  .split-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 44px;
    transform: translate(-50%, -50%);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    background:
      linear-gradient(var(--accent), var(--accent)) center / 1px 16px no-repeat,
      var(--bg-raised);
    transition: border-color var(--speed) var(--ease);
  }

  .split-label {
    position: absolute;
    top: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--bg-overlay);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .split-human {
    right: calc(50% + 0.5rem);
    color: var(--text-secondary);
  }

  .split-human::before {
    content: '← ';
  }

  .split-machine {
    left: calc(50% + 0.5rem);
    color: var(--accent);
  }

  .split-machine::after {
    content: ' →';
  }

  .machine-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding: 0.6rem 1.25rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    background: var(--bg-overlay);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .machine-bar[hidden] {
    display: none;
  }

  .bar-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bar-status strong {
    color: var(--accent);
    font-weight: 600;
  }

  .bar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar-dot {
      animation: bar-pulse 1.6s var(--ease) infinite;
    }

    @keyframes bar-pulse {
      50% {
        opacity: 0.35;
      }
    }
  }

  @media (max-width: 560px) {
    .bar-hint {
      display: none;
    }
  }

  .bar-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar-actions a {
    color: var(--text-secondary);
    margin-right: 0.25rem;
  }

  .machine-bar button {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    transition: color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  .machine-bar button:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
</style>
